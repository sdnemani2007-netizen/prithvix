# PrithviX Backend Configuration
# Copy this file to .env for LOCAL development only.
# Never commit or upload .env. In production, set these as hosting-platform environment variables.

DATABASE_URL=sqlite:///./prithvix.db

# Google Earth Engine
EE_PROJECT=prithvix-514718
EE_SERVICE_ACCOUNT_EMAIL=
EE_PRIVATE_KEY_PATH=

# Gemini AI -- NEVER put a real key in this file or in source control.
GEMINI_API_KEY=

# Comma-separated frontend origins. Set this to your exact deployed frontend origin in production.
# Example: https://app.example.com
PRITHVIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Cache duration in hours
PRITHVIX_CACHE_TTL_HOURS=24
